# Fichier volontairement en ASCII (voir docker-compose.yml).
#
# Mot de passe de la base : a choisir AVANT le premier demarrage (PostgreSQL ne le lit qu'a la
# creation de data/pg). Le meme aux deux endroits ci-dessous. Lettres et chiffres seulement :
# @ : / ? # % casseraient DATABASE_URL.

# Base de donnees (service db)
POSTGRES_USER=chaudron
POSTGRES_PASSWORD=chaudron
POSTGRES_DB=chaudron

# Serveur (service chaudron) : postgres://UTILISATEUR:MOT_DE_PASSE@db:5432/BASE
DATABASE_URL=postgres://chaudron:chaudron@db:5432/chaudron

# Port publie sur l'hote (28471 par defaut)
# CHAUDRON_PORT=28471

# URL publique de Chaudron, sans / final : URL de retour OAuth, liens d'invitation, cookies Secure.
# En https, les cookies sont marques Secure (obligatoire derriere un reverse proxy https).
PUBLIC_URL=http://localhost:28471

# Connexion avec Google (console Google Cloud, identifiant OAuth "Application Web").
# URL de retour autorisee : PUBLIC_URL/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Connexion avec Amazon (Login with Amazon, Security Profile, Web Settings).
# Allowed Return URL : PUBLIC_URL/api/v1/auth/amazon/callback
# AMAZON_CLIENT_ID=
# AMAZON_CLIENT_SECRET=

# Qui peut creer un compte. Les liens d'invitation passent toujours.
# Vide = seulement le tout premier compte (defaut), * = tout le monde, sinon des adresses separees par
# des virgules, qui s'appliquent aussi au premier compte : sur une instance exposee, mettre la sienne
# pour que personne ne devienne proprietaire a sa place.
# Les adresses ne valent que si le fournisseur les dit verifiees (Google oui, Amazon non).
# SIGNUP_ALLOWED_EMAILS=

# Fournisseur de connexion factice, sans mot de passe : DEV SEULEMENT, jamais sur une instance exposee.
# AUTH_FAKE=1

# Liaison de compte de la skill Alexa (console Alexa, Account Linking, "Auth Code Grant") :
# - Your Web Authorization URI : PUBLIC_URL/oauth/authorize
# - Access Token URI : PUBLIC_URL/api/v1/oauth/token, authentification "HTTP Basic"
# - Your Client ID et Your Secret : les deux valeurs ci-dessous (a choisir, longues et aleatoires)
# - Alexa Redirect URLs : celles affichees par la console, separees par des virgules (https seulement)
# Les trois vont ensemble.
# ALEXA_CLIENT_ID=
# ALEXA_CLIENT_SECRET=
# ALEXA_REDIRECT_URIS=
