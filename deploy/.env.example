# Fichier volontairement en ASCII (voir docker-compose.yml).
#
# Mot de passe de la base : a choisir AVANT le premier demarrage (PostgreSQL ne le lit qu'a la
# creation de data/pg). Le meme aux deux endroits ci-dessous. Lettres et chiffres seulement :
# @ : / ? # % casseraient DATABASE_URL.

# Base de donnees (service db)
POSTGRES_USER=chaudron
POSTGRES_PASSWORD=chaudron
POSTGRES_DB=chaudron

# Serveur (service chaudron) : postgres://UTILISATEUR:MOT_DE_PASSE@db:5432/BASE
DATABASE_URL=postgres://chaudron:chaudron@db:5432/chaudron

# Port publie sur l'hote (28471 par defaut)
# CHAUDRON_PORT=28471
