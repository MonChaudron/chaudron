{
  "name": "chaudron",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": ["apps/*", "packages/*", "alexa/lambda"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "npm run start -w app",
    "build:web": "npm run build:web -w app",
    "api:generate": "npm run generate -w @chaudron/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
